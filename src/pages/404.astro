---
import BaseLayout from '../layouts/BaseLayout.astro';
import { displayName } from '../data/profile';
import { withBase } from '../lib/url';

const title = `페이지를 찾을 수 없습니다 | ${displayName}`;
---

<BaseLayout title={title} description="요청한 페이지를 찾을 수 없습니다." path="/404.html" noindex>
  <section class="hero hero-compact">
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="lede">주소가 바뀌었거나 아직 공개되지 않은 페이지일 수 있습니다.</p>
    <p><a href={withBase('/')}>홈으로 돌아가기</a></p>
  </section>
</BaseLayout>
